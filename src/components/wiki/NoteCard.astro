---
import {
  Card,
  CardHeader,
  CardContent,
  CardFooter,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { wikiHref } from "@/lib/base-url";

interface Props {
  id: string;
  title: string;
  description?: string;
  growthStage: string;
  type?: string;
  complexity?: string;
}

const { id, title, description, growthStage, type, complexity } = Astro.props;
const href = wikiHref(id);
---

<a href={href} class="group block card-docker">
  <Card class="h-full hover:ring-primary border-0 shadow-none bg-transparent">
    <CardHeader class="font-medium leading-snug">
      {title}
    </CardHeader>
    {
      description && (
        <CardContent class="text-sm text-muted-foreground line-clamp-2">
          {description}
        </CardContent>
      )
    }
    <CardFooter class="flex items-center gap-2 flex-wrap">
      {type && (
        <Badge variant="secondary" class="text-[11px] leading-none">
          {type}
        </Badge>
      )}
      {complexity && (
        <Badge variant="outline" class="text-[11px] leading-none">
          {complexity}
        </Badge>
      )}
      <Badge variant="outline" class="text-[11px] leading-none">
        {growthStage}
      </Badge>
    </CardFooter>
  </Card>
</a>
